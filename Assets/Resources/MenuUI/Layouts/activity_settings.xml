<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settingsRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background -->
    <ImageView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/login_bg"
        android:scaleType="centerCrop"
        android:contentDescription="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Dark Overlay -->
    <View
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@drawable/menu_overlay"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header -->
    <Button
        android:id="@+id/btnBackSettings"
        android:layout_width="110dp"
        android:layout_height="45dp"
        android:background="@drawable/back_button"
        android:clickable="true"
        android:focusable="true"
        android:text="← BACK"
        android:textColor="#F2D58A"
        android:textSize="17sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="0dp"
        android:minWidth="0dp"
        android:minHeight="0dp"
        android:elevation="20dp"
        android:stateListAnimator="@null"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_marginStart="20dp"
        android:layout_marginTop="55dp" />

    <TextView
        android:id="@+id/txtSettingsTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SETTINGS"
        android:textColor="#64B5F6"
        android:textSize="32sp"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="@id/btnBackSettings"
        app:layout_constraintVertical_bias="0.5" />

    <TextView
        android:id="@+id/txtSettingsSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CUSTOMIZE YOUR EXPERIENCE"
        android:textColor="#DDDDDD"
        android:textSize="10sp"
        android:layout_marginTop="4dp"
        app:layout_constraintTop_toBottomOf="@id/txtSettingsTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Settings Panel -->
    <ScrollView
        android:id="@+id/settingsScroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:clipToPadding="false"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="10dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toBottomOf="@id/txtSettingsSubtitle"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:background="#D9102940">

            <!-- Graphics -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="GRAPHICS QUALITY"
                android:textColor="#64B5F6"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Choose your preferred visual quality."
                android:textColor="#DDDDDD"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerGraphics"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#64B5F6"
                android:entries="@array/graphics_quality_options"
                android:contentDescription="Graphics quality" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="#557DA8C7" />

            <!-- Touch Sensitivity -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TOUCH SENSITIVITY"
                android:textColor="#64B5F6"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtSensitivityValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Sensitivity: 50%"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekSensitivity"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:max="100"
                android:progress="50"
                android:contentDescription="Touch sensitivity"
                android:progressTint="#42A5F5"
                android:thumbTint="#90CAF9" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="14dp"
                android:background="#557DA8C7" />

            <!-- Language -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="LANGUAGE"
                android:textColor="#64B5F6"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Select your preferred language."
                android:textColor="#DDDDDD"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/spinnerLanguage"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="6dp"
                android:backgroundTint="#64B5F6"
                android:entries="@array/language_options"
                android:contentDescription="Language" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="14dp"
                android:background="#557DA8C7" />

            <!-- Sound -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="SOUND SETTINGS"
                android:textColor="#64B5F6"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtMasterVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Master Volume: 80%"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekMasterVolume"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:max="100"
                android:progress="80"
                android:contentDescription="Master volume"
                android:progressTint="#42A5F5"
                android:thumbTint="#90CAF9" />

            <TextView
                android:id="@+id/txtSfxVolume"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Sound Effects: 80%"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />

            <SeekBar
                android:id="@+id/seekSfxVolume"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:max="100"
                android:progress="80"
                android:contentDescription="Sound effects volume"
                android:progressTint="#42A5F5"
                android:thumbTint="#90CAF9" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Your preferences will be saved automatically."
                android:textColor="#B0BEC5"
                android:textSize="11sp" />

        </LinearLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>